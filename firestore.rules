rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /loans/{loanId} {
      allow read, write: if true;
    }

    match /investments/{investmentId} {
      allow read, write: if true;
    }

    match /chat_messages/{messageId} {
      allow read, write: if true;
    }
  }
}
